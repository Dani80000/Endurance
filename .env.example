# Runtime
ENVIRONMENT=development
HOST=127.0.0.1
PORT=10000
LOG_LEVEL=INFO

# Secrets: replace these in your real .env file.
SECRET_KEY=replace_with_a_long_random_secret
FERNET_KEY=replace_with_a_fernet_key

# Browser / proxy access.
# Use * for local development. In production, prefer exact origins:
# ALLOWED_ORIGINS=https://chat.example.com,https://www.chat.example.com
ALLOWED_ORIGINS=*

# Upload limits are enforced on base64/data-url payload size.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880
